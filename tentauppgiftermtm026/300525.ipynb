   "source": [
    "from mtm026 import *\n",
    "a = sp.symbols(\"a\")\n",
    "n = 4\n",
    "C = 11.2e-12\n",
    "R = 0.007\n",
    "sigma0 = 150e6\n",
    "a0 = 0.004\n",
    "ac = 0.011\n",
    "f = sp.sqrt((a+R)/a)\n",
    "deltak = sigma0*sp.sqrt(np.pi*a)*f\n",
    "I = 1/(C*deltak**n)\n",
    "N = float(sp.integrate(I, (a, a0, ac)))\n",
    "display(N)"
   ]
  }
 ],
